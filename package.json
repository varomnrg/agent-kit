{
  "name": "@varomnrg/agent-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Timothy's modular, curated agent skill catalog",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./integrations/herdr-team/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/**/*.test.ts",
    "validate": "node scripts/validate-catalog.mjs",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/validate-catalog.mjs --check-catalog",
    "test:clean-home": "bash scripts/test-clean-pi-home.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest",
    "yaml": "^2.9.1"
  }
}
